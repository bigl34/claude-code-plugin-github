{
  "name": "github-manager",
  "version": "1.3.2",
  "description": "GitHub repository, issue, and PR management via gh CLI",
  "repository": "https://github.com/bigl34/claude-code-plugin-github",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REDACTED-PRE-COMMIT"
      }
    }
  }
}
